# This project calls Groq. Leave the values empty in git.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Set LLM_API_KEY in the environment. Do not put a key in this file.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=3

MAX_CANDIDATES=20
DEFAULT_TOP_K=5

BUDGET_LOW=300
BUDGET_MEDIUM_MAX=600